{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/schemas/wrangler.json",
  // 由 Workers Builds 构建时自动渲染（${VAR} 从 Dashboard 环境变量注入）
  // 本地开发：复制此文件为 wrangler.jsonc，手动填入真实值
  //
  // 需要在 Cloudflare Dashboard 配置以下环境变量：
  //   R2_BUCKET_NAME  — R2 bucket 名称
  // 真正的 secret 通过 `wrangler secret` 管理，不在此文件中

  "name": "gateway",
  "main": "index.js",
  "compatibility_date": "2026-02-10",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "${R2_BUCKET_NAME}"
    }
  ]
}
